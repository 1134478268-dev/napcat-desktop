#!/bin/sh
# 提交信息规范检查：Conventional Commits
# 格式：<type>(<scope>): <subject>
# 例：feat(ai): 网关支持表情包发送
#
# 为什么用 hook 而不是靠自觉：提交信息一旦写乱，事后只能靠翻 diff 猜意图。
# 这个检查只拦「第一行格式」，不限制正文。
#
# 临时跳过：git commit --no-verify

msg=$(head -1 "$1")

if printf '%s' "$msg" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'; then
  exit 0
fi

echo "" >&2
echo "提交信息不符合规范" >&2
echo "" >&2
echo "  当前：$msg" >&2
echo "  要求：<type>(<scope>): <subject>" >&2
echo "" >&2
echo "  type: feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert" >&2
echo "  例：  feat(ai): 网关支持表情包发送" >&2
echo "        fix(frontend): 修复保存后流程中断" >&2
echo "" >&2
exit 1
